{
  "expo": {
    "name": "إدارة اتحاد الملاك",
    "slug": "bm-mobile",
    "version": "1.0.3",
    "runtimeVersion": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "bm",
    "assetBundlePatterns": [
      "**/*"
    ],
    "updates": {
      "enabled": false
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "sa.pm.bm",
      "icon": "./assets/icon.png"
    },
    "android": {
      "package": "sa.pm.bm",
      "versionCode": 4,
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#051836"
      },
      "softwareKeyboardLayoutMode": "resize"
    },
    "extra": {
      "apiUrl": "https://bm.pm.sa/api"
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      "expo-secure-store",
      "expo-status-bar",
      "expo-notifications"
    ]
  }
}
