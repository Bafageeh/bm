{
  "name": "bm-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "patch-ui": "node scripts/owner-actions-menu.js && node scripts/add-screen-numbers.js && node scripts/beautify-icons-and-notifications.js && node scripts/fallback-system-icons.js && node scripts/automatic-ota-updates.js",
    "prestart": "npm run patch-ui",
    "start": "expo start --go",
    "preandroid": "npm run patch-ui",
    "android": "expo start --android",
    "preios": "npm run patch-ui",
    "ios": "expo start --ios",
    "preweb": "npm run patch-ui",
    "web": "expo start --web"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "expo": "~57.0.24",
    "expo-asset": "~57.0.18",
    "expo-font": "~57.0.4",
    "expo-notifications": "~57.0.20",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.23",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "expo-document-picker": "~57.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "babel-preset-expo": "~57.0.0"
  }
}
